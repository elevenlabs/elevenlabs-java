# Specify files that shouldn't be modified by Fern
README.md

# Hand-written agent workflows-as-code builder (spec: elevenlabs-js docs/agents-as-code/workflow-spec.md).
# Fern doesn't generate it; it sits on top of the generated AgentWorkflowRequestModel. Its CanonicalJson
# writer and Destination type are public so a later agent tools builder can reuse them. The fixtures are
# the shared cross-SDK golden files, vendored so they can't drift silently.
src/main/java/com/elevenlabs/api/agentworkflows/
src/test/java/com/elevenlabs/api/agentworkflows/
src/test/resources/agentworkflows/

# Hand-written agent tools-as-code builder (spec: elevenlabs-js docs/agents-as-code/tool-spec.md). Fern doesn't
# generate it; it sits on top of the generated ToolRequestModel and reuses the workflow builder's CanonicalJson and
# Destination. The fixtures are the shared cross-SDK golden files, vendored so they can't drift silently.
src/main/java/com/elevenlabs/api/agenttools/
src/test/java/com/elevenlabs/api/agenttools/
src/test/resources/agenttools/

# Music compose_detailed, parsed: POST /v1/music/detailed returns multipart/mixed (a JSON part, then the
# audio), which the generated MusicClient.composeDetailed decodes as JSON and gets null. MusicDetailed
# sends the same request and splits the parts. Remove once the generator handles multipart responses.
src/main/java/com/elevenlabs/api/resources/music/MusicDetailed.java
src/main/java/com/elevenlabs/api/resources/music/ComposeDetailedResponse.java
src/main/java/com/elevenlabs/api/resources/music/MultipartParser.java
src/test/java/com/elevenlabs/api/resources/music/MusicDetailedTest.java

# Hand-written webhook signature verifier (Fern's generated verifier can't parse the compound
# `ElevenLabs-Signature: t=...,v0=...` header). Standalone rather than a method on the generated
# WebhooksClient, which Java can't extend without freezing that whole generated file.
src/main/java/com/elevenlabs/api/webhooks/
src/test/java/com/elevenlabs/api/webhooks/

# Hand-written Flows createAndWait helpers (start an image/video/text-to-speech generation or a
# template run, then poll the generated get until it is completed or failed, honouring the
# server's Retry-After). Java has no partial classes, and the generated Flows clients are rewritten
# on every regeneration, so this is a separate entry point (FlowsWaiter) that sends through the
# generated clients' withRawResponse(), the only path that exposes the Retry-After header.
src/main/java/com/elevenlabs/api/flows/wait/
src/test/java/com/elevenlabs/api/flows/wait/
