# Specify files that shouldn't be modified by Fern
README.md

# Hand-written release workflow: runs only when a GitHub release is published and publishes to Maven
# Central with the same account and signing key as elevenlabs-android.
.github/workflows/release.yml
# Gives Gradle enough heap to build the javadoc and sources jars a Maven Central release needs.
gradle.properties

# Hand-written agent workflows-as-code builder (spec: elevenlabs-js docs/agents-as-code/workflow-spec.md).
# Fern doesn't generate it; it sits on top of the generated AgentWorkflowRequestModel. Its CanonicalJson
# writer and Destination type are public so a later agent tools builder can reuse them. The fixtures are
# the shared cross-SDK golden files, vendored so they can't drift silently.
src/main/java/com/elevenlabs/api/agentworkflows/
src/test/java/com/elevenlabs/api/agentworkflows/
src/test/resources/agentworkflows/

# Hand-written agent tools-as-code builder (spec: elevenlabs-js docs/agents-as-code/tool-spec.md). Fern doesn't
# generate it; it sits on top of the generated ToolRequestModel and reuses the workflow builder's CanonicalJson and
# Destination. The fixtures are the shared cross-SDK golden files, vendored so they can't drift silently.
src/main/java/com/elevenlabs/api/agenttools/
src/test/java/com/elevenlabs/api/agenttools/
src/test/resources/agenttools/

# Hand-written agents-as-code builder (spec: elevenlabs-js docs/agents-as-code/agent-spec.md): the Agent builder,
# agents().push()/pull() and AgentProject, the ElevenLabs CLI's project layout. Fern doesn't generate it; it sits on
# top of the generated agents and tools clients and reuses the workflow and tools builders above. AgentsClientWrapper
# extends the generated AgentsClient and ElevenLabsClient.agents() returns it. The cli-graph fixture is the shared
# cross-SDK project, vendored byte for byte so the SDKs can't drift silently.
src/main/java/com/elevenlabs/api/agentbuilder/
src/test/java/com/elevenlabs/api/agentbuilder/
src/test/resources/agentbuilder/

# Hand-written Speech Engine server model (the developer hosts a WebSocket server that the
# ElevenLabs API dials into). The generator produces only the client-dials-out upstream socket
# (resources/speechengine/websocket); this package adds the inbound-connection JWT verifier, the
# per-connection session/protocol, the standalone Java-WebSocket server, the Jakarta servlet
# container integration, the engine resource and the wired speech engine client.
src/main/java/com/elevenlabs/api/speechengine/
src/test/java/com/elevenlabs/api/speechengine/

# Hand-written root client wiring: ElevenLabsClient extends the generated ElevenlabsApiClient and
# overrides speechEngine() to return the SpeechEngineClientWrapper (whose create/get/update/
# duplicate return a SpeechEngineResource), and agents() to return the AgentsClientWrapper (which adds push/pull for
# agents as code). The generator emits only ElevenlabsApiClient.
src/main/java/com/elevenlabs/api/ElevenLabsClient.java
src/main/java/com/elevenlabs/api/ElevenLabsClientBuilder.java

# Hand-edited generated model: made non-final with a protected constructor so SpeechEngineResource
# can extend it, which is what lets the wrapper return the resource through a covariant override
# (Java cannot otherwise change an overridden method's return type). The only change is those two
# modifiers. When the API changes this model, regenerate it, then re-apply them: a frozen copy
# that falls behind fails loudly, because the regenerated SpeechEngineResponseTest and wire tests
# stop compiling against it.
src/main/java/com/elevenlabs/api/types/SpeechEngineResponse.java

# Frozen for the Speech Engine server's compileOnly dependencies (Java-WebSocket and the Jakarta
# Servlet/WebSocket APIs) and the test dependencies that exercise them (embedded Tomcat 10.0).
# Dependencies or settings the generator adds later must be merged in by hand.
build.gradle

# Music compose_detailed, parsed: POST /v1/music/detailed returns multipart/mixed (a JSON part, then the
# audio), which the generated MusicClient.composeDetailed returns as one raw InputStream. MusicDetailed
# sends the same request and splits the parts. Remove once the generator handles multipart responses.
src/main/java/com/elevenlabs/api/resources/music/MusicDetailed.java
src/main/java/com/elevenlabs/api/resources/music/ComposeDetailedResponse.java
src/main/java/com/elevenlabs/api/resources/music/MultipartParser.java
src/test/java/com/elevenlabs/api/resources/music/MusicDetailedTest.java

# Hand-written webhook signature verifier (Fern's generated verifier can't parse the compound
# `ElevenLabs-Signature: t=...,v0=...` header). Standalone rather than a method on the generated
# WebhooksClient, which Java can't extend without freezing that whole generated file.
src/main/java/com/elevenlabs/api/webhooks/
src/test/java/com/elevenlabs/api/webhooks/

# Hand-written Flows createAndWait helpers (start an image/video/text-to-speech generation or a
# template run, then poll the generated get until it is completed or failed, honouring the
# server's Retry-After). Java has no partial classes, and the generated Flows clients are rewritten
# on every regeneration, so this is a separate entry point (FlowsWaiter) that sends through the
# generated clients' withRawResponse(), the only path that exposes the Retry-After header.
src/main/java/com/elevenlabs/api/flows/wait/
src/test/java/com/elevenlabs/api/flows/wait/
